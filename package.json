{
  "name": "sync-splat",
  "version": "0.4.0",
  "description": "Share text and small files between devices on your local network. Run it, scan the QR code, splat.",
  "type": "module",
  "license": "MIT",
  "author": "Joseph Maynard",
  "repository": {
    "type": "git",
    "url": "https://github.com/josephmaynard/sync-splat"
  },
  "keywords": [
    "clipboard",
    "lan",
    "share",
    "sync",
    "qr",
    "local-network"
  ],
  "bin": {
    "sync-splat": "bin/sync-splat.js"
  },
  "files": [
    "bin/sync-splat.js",
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k npm:dev:server npm:dev:client",
    "dev:server": "npm run build:server && node bin/sync-splat.js",
    "dev:client": "vite --host",
    "start": "node bin/sync-splat.js",
    "typecheck": "tsc -b",
    "build": "npm run typecheck && npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "node scripts/build-server.mjs",
    "test": "vitest run",
    "lint": "eslint .",
    "prepublishOnly": "npm run lint && npm run build && npm run test",
    "test:e2e": "pnpm build && playwright test"
  },
  "dependencies": {
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@heroicons/react": "^2.2.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.5",
    "dompurify": "^3.4.14",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@9.5.0+sha512.140036830124618d624a2187b50d04289d5a087f326c9edfc0ccd733d76c4f52c3a313d4fc148794a2a9d81553016004e6742e8cf850670268a7387fc220c903"
}
